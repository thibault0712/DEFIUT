rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Flags : jamais lisibles ni modifiables par les clients
    match /flags/{challengeId} {
      allow read, write: if false;
    }

    // Défis : lecture publique, écriture interdite aux clients
    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if false;
    }

    // Utilisateurs : lecture publique
    // Écriture limitée aux champs de profil (pas points/challenges/badges)
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['points', 'challenges', 'badges']);
    }

    // Sous-collection hintsPurchased : inaccessible aux clients
    match /users/{uid}/hintsPurchased/{doc} {
      allow read, write: if false;
    }
  }
}
